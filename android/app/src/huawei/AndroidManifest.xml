<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- =================================================================== -->
    <!-- HUAWEI APPGALLERY FLAVOR MANIFEST OVERLAY (`src/huawei/...`)        -->
    <!-- Strips any Google Play Services permissions/receivers and declares  -->
    <!-- Huawei HMS Core & AppGallery market metadata.                       -->
    <!-- =================================================================== -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="com.android.vending.BILLING"
        tools:node="remove" />

    <queries>
        <!-- Allow querying HMS Core & Huawei AppGallery on Android 11+ -->
        <package android:name="com.huawei.hwid" />
        <package android:name="com.huawei.hms" />
        <package android:name="com.huawei.appmarket" />
    </queries>

    <application android:label="@string/app_name">
        <meta-data
            android:name="com.syspulse.store_channel"
            android:value="huawei_appgallery" />
        <meta-data
            android:name="com.huawei.hms.client.channel.androidMarket"
            android:value="true" />
    </application>
</manifest>
